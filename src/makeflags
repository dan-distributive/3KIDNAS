locObj=$(ROOT_DIR)/ObjectLists

include $(locObj)

.f.o:
	$(F77) $(FLAGS) -c -I$(LocModLoc) $(FFTW_INCL) *.f

.c.o:
	$(CC) $(CFLAGS) -c *.c


F77=gfortran
CC=gcc
FLAGS=-O0 -funroll-loops -cpp -fbounds-check -Wl,-ld_classic
CFLAGS= -O -DRINGASCII -DASCII



MakeFObj=$(F77) $(FLAGS) -c -I$(LocModLoc) $(FFTW_INCL)
