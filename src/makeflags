##compiler options

ROOT_DIR:=$(shell dirname $(realpath $(lastword $(MAKEFILE_LIST))))
PARENT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)

LocModLoc=$(ROOT_DIR)/mods
LocBinLoc=$(ROOT_DIR)/bin


## --- Library locations ---------------------------------------------------
## Native macOS build against the bundled third_party sources.
## (The Linux system-path variants below are kept commented for reference.)
##
## IMPORTANT: third_party/fftw-3.3.8 MUST be built with -ffp-contract=off in
## every generated Makefile's CFLAGS (all ~51 of them, not just the top-level
## one -- autotools generates one per subdirectory). Without it, gcc/clang
## fuse FFTW3's internal accumulation loops (e.g. dft/generic.c's cdot(),
## rdft/generic.c's cdot_r2hc()) into hardware FMA instructions on arm64
## (verified via disassembly), which plain JS cannot reproduce (no FMA
## access) and which isn't even a stable target across FFTW3's own
## deployment platforms (FMA is mandatory on arm64 but an optional,
## normally-off x86-64 extension). If FFTW3 is ever rebuilt from a fresh
## `./configure`, re-patch every generated Makefile's CFLAGS line before
## running `make`, e.g.:
##   find third_party/fftw-3.3.8 -name Makefile -exec \
##     sed -i '' 's/^CFLAGS = .*/& -ffp-contract=off/' {} \;

FFTW_INCL=  -I$(PARENT_DIR)/third_party/fftw-3.3.8/api
FFTW_LIBS=  $(PARENT_DIR)/third_party/fftw-3.3.8/.libs
FFTW_LIB = $(FFTW_LIBS)/libfftw3.a

FitsLibLoc=$(PARENT_DIR)/third_party/cfitsio-4.6.3/.libs/libcfitsio.a

## --- Previous configurations (inactive) ----------------------------------
